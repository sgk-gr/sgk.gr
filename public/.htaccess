<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # 1. Αν το request είναι για το backend, μην κάνεις rewrite
  RewriteCond %{REQUEST_URI} ^/backend [NC]
  RewriteRule ^ - [L]
  
  # 2. Αν το αρχείο ή ο φάκελος υπάρχει πραγματικά (π.χ. blog-seo/...), σέρβιρέ το κανονικά
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  
  # 3. Για όλα τα άλλα (React Routing), στείλε στο index.html
  RewriteRule ^index\.html$ - [L]
  RewriteRule . /index.html [L]
</IfModule>
